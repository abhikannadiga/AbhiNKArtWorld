/* ===========================
   Home Banner
=========================== */

.hero{
    width:100%;
    min-height:100vh;
    background:url("../images/banner.png") no-repeat center center;
    background-size:contain;
    background-color:#111;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
    padding:20px;
}

.hero::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.15);
}

.hero-content{
    position:relative;
    z-index:2;
    text-align:center;
}

.hero-content h1,
.hero-content h2,
.hero-content p{
    display:none;
}

.banner-buttons{
    position:absolute;
    bottom:30px;
    left:50%;
    transform:translateX(-50%);
    display:flex;
    gap:15px;
    z-index:5;
}

.banner-buttons .btn{
    padding:15px 35px;
    background:gold;
    color:#000;
    text-decoration:none;
    border-radius:30px;
    font-weight:bold;
    transition:.3s;
}

.banner-buttons .btn:hover{
    background:#fff;
}

@media(max-width:768px){

.hero{
    min-height:70vh;
    background-size:contain;
}

.banner-buttons{
    flex-direction:column;
    bottom:20px;
}

.banner-buttons .btn{
    width:180px;
    text-align:center;
}

}
