/* ==========================================
   Abhi NK Art World - Premium CSS
========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#111;
    color:#fff;
    line-height:1.6;
}

/* ================= HEADER ================= */

header{
    width:100%;
    position:fixed;
    top:0;
    left:0;
    background:#000;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 8%;
    z-index:999;
    box-shadow:0 0 15px rgba(255,215,0,.25);
}

.logo{
    font-size:30px;
    font-weight:bold;
    color:#fff;
}

.logo span{
    color:gold;
}

/* ================= MENU ================= */

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{

    color:#fff;

    text-decoration:none;

    font-size:18px;

    transition:.3s;

}

nav ul li a:hover,
nav ul li a.active{

    color:gold;

}

/* ================= HOME BANNER ================= */

.hero{

    width:100%;

    height:100vh;

    background:url("../images/banner.jpg");

    background-size:cover;

    background-position:center;

    background-repeat:no-repeat;

    display:flex;

    justify-content:center;

    align-items:center;

    position:relative;

}

.hero-overlay{

    position:absolute;

    width:100%;

    height:100%;

    background:rgba(0,0,0,.35);

}

.hero-content{

    position:relative;

    z-index:10;

    text-align:center;

}

.hero-content h1{

    font-size:45px;

}

.hero-content h2{

    font-size:65px;

    color:gold;

    margin:15px 0;

}

.hero-content p{

    max-width:700px;

    margin:auto;

    font-size:22px;

    margin-bottom:35px;

}

.btn{

    display:inline-block;

    padding:15px 35px;

    background:gold;

    color:#000;

    text-decoration:none;

    border-radius:40px;

    font-weight:bold;

    margin:8px;

    transition:.3s;

}

.btn:hover{

    background:#fff;

    transform:translateY(-4px);

}

/* ================= SECTION ================= */

section{

    padding:80px 8%;

}

section h2{

    text-align:center;

    color:gold;

    font-size:40px;

    margin-bottom:40px;

}
/* ==========================================
   ABOUT SECTION
========================================== */

.about-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:30px;
}

.box{

    background:#1b1b1b;

    padding:30px;

    border-radius:15px;

    text-align:center;

    transition:.4s;

    border:1px solid #333;

}

.box:hover{

    transform:translateY(-10px);

    box-shadow:0 10px 25px rgba(255,215,0,.25);

}

.box i{

    font-size:55px;

    color:gold;

    margin-bottom:20px;

}

.box h3{

    margin-bottom:15px;

    color:gold;

}

.box p{

    color:#ddd;

    line-height:1.8;

}

/* ==========================================
   SERVICES
========================================== */

.service-container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:30px;

}

.service-card{

    background:#202020;

    border-radius:15px;

    padding:35px;

    text-align:center;

    transition:.4s;

    border:1px solid #444;

}

.service-card:hover{

    transform:translateY(-10px);

    box-shadow:0 10px 25px rgba(255,215,0,.30);

}

.service-card i{

    color:gold;

    margin-bottom:20px;

}

.service-card h3{

    color:gold;

    margin:20px 0;

}

.service-card p{

    color:#ddd;

}

/* ==========================================
   GALLERY
========================================== */

.gallery-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:25px;

}

.gallery-grid img{

    width:100%;

    height:320px;

    object-fit:cover;

    border-radius:15px;

    transition:.4s;

    cursor:pointer;

    border:3px solid #222;

}

.gallery-grid img:hover{

    transform:scale(1.05);

    border-color:gold;

    box-shadow:0 10px 30px rgba(255,215,0,.35);

}

/* ==========================================
   BUTTONS
========================================== */

.btn{

    display:inline-block;

    padding:14px 34px;

    background:gold;

    color:#000;

    text-decoration:none;

    border-radius:30px;

    font-weight:600;

    transition:.3s;

}

.btn:hover{

    background:#fff;

    color:#000;

}
/* ==========================================
   CONTACT SECTION
========================================== */

.contact-home{
    text-align:center;
}

.contact-home p{
    font-size:20px;
    margin:15px 0;
    color:#ddd;
}

.contact-home i{
    color:gold;
    margin-right:10px;
    font-size:22px;
}

.whatsapp-btn{
    display:inline-block;
    margin-top:25px;
    padding:15px 35px;
    background:#25D366;
    color:#fff;
    text-decoration:none;
    border-radius:40px;
    font-size:18px;
    font-weight:bold;
    transition:.3s;
}

.whatsapp-btn:hover{
    background:#1EBE5D;
    transform:scale(1.05);
}

/* ==========================================
   FOOTER
========================================== */

footer{
    background:#000;
    padding:30px;
    text-align:center;
    margin-top:40px;
}

footer p{
    color:#bbb;
    font-size:16px;
}

/* ==========================================
   FLOATING WHATSAPP
========================================== */

.floating-whatsapp{
    position:fixed;
    right:25px;
    bottom:25px;
    width:65px;
    height:65px;
    background:#25D366;
    color:#fff;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    text-decoration:none;
    font-size:34px;
    box-shadow:0 5px 15px rgba(0,0,0,.4);
    transition:.3s;
    z-index:999;
}

.floating-whatsapp:hover{
    transform:scale(1.15);
}

/* ==========================================
   IMAGE ANIMATION
========================================== */

.gallery-grid img{
    animation:fadeIn .8s ease;
}

@keyframes fadeIn{

    from{
        opacity:0;
        transform:translateY(20px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

/* ==========================================
   RESPONSIVE
========================================== */

@media(max-width:768px){

header{

flex-direction:column;

padding:15px;

}

.logo{

font-size:24px;

margin-bottom:10px;

}

nav ul{

flex-wrap:wrap;

justify-content:center;

}

nav ul li{

margin:8px;

}

.hero{

height:70vh;

background-size:contain;

background-color:#111;

}

.hero-content h1{

font-size:30px;

}

.hero-content h2{

font-size:40px;

}

.hero-content p{

font-size:16px;

padding:0 15px;

}

section{

padding:50px 20px;

}

section h2{

font-size:30px;

}

.gallery-grid img{

height:220px;

}

.service-card{

padding:20px;

}

.about-grid{

grid-template-columns:1fr;

}

.service-container{

grid-template-columns:1fr;

}

.gallery-grid{

grid-template-columns:1fr;

}

.floating-whatsapp{

width:55px;

height:55px;

font-size:28px;

right:15px;

bottom:15px;

}

}
