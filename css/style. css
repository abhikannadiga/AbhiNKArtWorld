/* ==========================================
   Abhi NK Art World
========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#111;
    color:#fff;
    line-height:1.6;
}

/* Header */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    background:#000;
    padding:15px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:999;
    box-shadow:0 3px 15px rgba(255,215,0,.2);
}

.logo{
    font-size:30px;
    font-weight:bold;
}

.logo span{
    color:gold;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{
    color:#fff;
    text-decoration:none;
    font-size:18px;
    transition:.3s;
}

nav ul li a:hover,
nav ul li a.active{
    color:gold;
}
/* ==========================================
   HERO SECTION
========================================== */

.hero{
    position:relative;
    width:100%;
    height:100vh;
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
}

/* Slider */

.slider{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
}

.slide{
    position:absolute;
    width:100%;
    height:100%;
    object-fit:cover;
    opacity:0;
    transition:opacity 1.2s ease-in-out;
}

.slide.active{
    opacity:1;
}

/* Dark Overlay */

.hero::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.45);
    z-index:1;
}

/* Hero Content */

.hero-content{
    position:relative;
    z-index:2;
    text-align:center;
    color:#fff;
    max-width:800px;
    padding:20px;
}

.hero-content h1{
    font-size:50px;
    margin-bottom:10px;
}

.hero-content h2{
    font-size:70px;
    color:gold;
    margin-bottom:20px;
}

.hero-content p{
    font-size:22px;
    margin-bottom:35px;
    line-height:1.8;
}

/* Buttons */

.btn{
    display:inline-block;
    padding:15px 35px;
    margin:10px;
    background:gold;
    color:#000;
    text-decoration:none;
    font-weight:bold;
    border-radius:50px;
    transition:0.3s;
}

.btn:hover{
    background:#fff;
    transform:translateY(-5px);
}
/* ==========================================
   SECTION
========================================== */

section{
    padding:80px 8%;
}

section h2{
    text-align:center;
    font-size:40px;
    color:gold;
    margin-bottom:50px;
}

/* ==========================================
   ABOUT
========================================== */

.about-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:30px;
}

.box{
    background:#1e1e1e;
    border-radius:15px;
    padding:30px;
    text-align:center;
    transition:.4s;
}

.box:hover{
    transform:translateY(-10px);
    box-shadow:0 10px 25px rgba(255,215,0,.25);
}

.box i{
    font-size:55px;
    color:gold;
    margin-bottom:20px;
}

.box h3{
    margin-bottom:15px;
    color:gold;
}

.box p{
    color:#ddd;
}

/* ==========================================
   SERVICES
========================================== */

.service-container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:30px;
}

.service-card{
    background:#222;
    padding:35px;
    border-radius:15px;
    text-align:center;
    transition:.4s;
}

.service-card:hover{
    transform:translateY(-10px);
    box-shadow:0 10px 25px rgba(255,215,0,.25);
}

.service-card i{
    font-size:50px;
    color:gold;
    margin-bottom:20px;
}

.service-card h3{
    margin:15px 0;
    color:gold;
}

.service-card p{
    color:#ddd;
}

/* ==========================================
   GALLERY
========================================== */

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.gallery-grid img{
    width:100%;
    height:320px;
    object-fit:cover;
    border-radius:12px;
    transition:.4s;
    cursor:pointer;
}

.gallery-grid img:hover{
    transform:scale(1.05);
    box-shadow:0 10px 25px rgba(255,215,0,.35);
}
/* ==========================================
   CONTACT SECTION
========================================== */

.contact-home{
    text-align:center;
    padding:80px 8%;
}

.contact-home p{
    font-size:20px;
    margin:15px 0;
    color:#ddd;
}

.contact-home i{
    color:gold;
    margin-right:10px;
    font-size:22px;
}

/* WhatsApp Button */

.whatsapp-btn{
    display:inline-block;
    margin-top:25px;
    padding:15px 35px;
    background:#25D366;
    color:#fff;
    text-decoration:none;
    border-radius:40px;
    font-size:18px;
    font-weight:bold;
    transition:.3s;
}

.whatsapp-btn:hover{
    background:#1ebe5d;
    transform:translateY(-5px);
}

/* ==========================================
   FOOTER
========================================== */

footer{
    background:#000;
    text-align:center;
    padding:30px;
}

footer p{
    color:#bbb;
}

/* ==========================================
   FLOATING WHATSAPP
========================================== */

.floating-whatsapp{
    position:fixed;
    right:20px;
    bottom:20px;
    width:65px;
    height:65px;
    background:#25D366;
    color:#fff;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    text-decoration:none;
    font-size:34px;
    box-shadow:0 5px 20px rgba(0,0,0,.4);
    z-index:999;
    transition:.3s;
}

.floating-whatsapp:hover{
    transform:scale(1.15);
}

/* ==========================================
   SCROLL TO TOP BUTTON
========================================== */

#topBtn{
    position:fixed;
    bottom:100px;
    right:20px;
    width:50px;
    height:50px;
    background:gold;
    color:#000;
    border:none;
    border-radius:50%;
    cursor:pointer;
    display:none;
    font-size:22px;
    z-index:999;
}

#topBtn:hover{
    background:#fff;
}

/* ==========================================
   FADE ANIMATION
========================================== */

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(40px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

section{
    animation:fadeUp .8s ease;
}

/* ==========================================
   MOBILE RESPONSIVE
========================================== */

@media(max-width:768px){

header{
    flex-direction:column;
    padding:15px;
}

.logo{
    font-size:24px;
    margin-bottom:10px;
}

nav ul{
    flex-wrap:wrap;
    justify-content:center;
}

nav ul li{
    margin:8px;
}

.hero{
    height:80vh;
}

.hero-content h1{
    font-size:32px;
}

.hero-content h2{
    font-size:42px;
}

.hero-content p{
    font-size:18px;
}

.btn{
    display:block;
    width:220px;
    margin:15px auto;
}

.about-grid,
.service-container,
.gallery-grid{
    grid-template-columns:1fr;
}

.gallery-grid img{
    height:240px;
}

section{
    padding:60px 20px;
}

.contact-home p{
    font-size:18px;
}

}
